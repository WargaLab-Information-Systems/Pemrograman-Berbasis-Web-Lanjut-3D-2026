{
    "version": 2,
    "buildCommand": "npm run build",
    "outputDirectory": "public",
    "regions": ["sin1"],
    "functions": {
        "api/index.php": {
            "runtime": "vercel-php@0.9.0"
        }
    },
    "routes": [
        {
            "src": "/build/(.*)",
            "dest": "/build/$1",
            "headers": {
                "cache-control": "public, max-age=31536000, immutable"
            }
        },
        {
            "src": "/(favicon.ico|robots.txt|.*\\.(css|js|png|jpg|jpeg|gif|svg|ico|woff|woff2|ttf|eot))",
            "dest": "/$1",
            "headers": {
                "cache-control": "public, max-age=86400"
            }
        },
        {
            "src": "/(.*)",
            "dest": "/api/index.php"
        }
    ]
}
